rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isOptionalString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    function validSlug(s) {
      return s is string
        && s.size() >= 2
        && s.size() <= 80
        && s.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    function validPrice(p) {
      return p == null || (p is number && p >= 0 && p <= 100000);
    }

    function validUrl(u) {
      return u == null
        || (u is string && u.size() == 0)
        || (u is string && u.size() <= 2048 && (
             u.matches('^https://.*')
          || u.matches('^assets/.*')
          || u.matches('^/.*')
        ));
    }

    function validFeatures(list) {
      return list is list && list.size() <= 12;
    }

    function validStringArray(list, maxItems, maxLen) {
      return list is list && list.size() <= maxItems;
    }

    function presetKeysOk() {
      return request.resource.data.keys().hasOnly([
        'name', 'slug', 'shortDescription', 'description',
        'price', 'currency', 'category', 'platform',
        'compatibleDevices', 'includes', 'presets', 'snapshots',
        'badges', 'features', 'thumb', 'imageUrl', 'gallery',
        'whatsappNumber', 'whatsappMessage', 'downloadUrl',
        'free', 'featured', 'published', 'sortOrder',
        'createdAt', 'updatedAt'
      ]);
    }

    function presetDataValid() {
      let d = request.resource.data;
      return presetKeysOk()
        && isNonEmptyString(d.name, 120)
        && validSlug(d.slug)
        && isNonEmptyString(d.shortDescription, 400)
        && isNonEmptyString(d.description, 5000)
        && validPrice(d.price)
        && d.currency is string && d.currency.size() <= 8
        && isNonEmptyString(d.category, 40)
        && isNonEmptyString(d.platform, 80)
        && validStringArray(d.compatibleDevices, 20, 80)
        && validStringArray(d.includes, 30, 200)
        && (!('presets' in d) || d.presets == null || validStringArray(d.presets, 40, 80))
        && (!('snapshots' in d) || d.snapshots == null || validStringArray(d.snapshots, 40, 80))
        && validStringArray(d.badges, 12, 40)
        && validFeatures(d.features)
        && isOptionalString(d.thumb, 40)
        && validUrl(d.imageUrl)
        && validStringArray(d.gallery, 12, 2048)
        && isOptionalString(d.whatsappNumber, 20)
        && isOptionalString(d.whatsappMessage, 500)
        && validUrl(d.downloadUrl)
        && d.free is bool
        && d.featured is bool
        && d.published is bool
        && d.sortOrder is number && d.sortOrder >= 0 && d.sortOrder <= 100000
        && d.updatedAt is timestamp;
    }

    function siteSettingsValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'whatsappNumber', 'whatsappDisplay', 'brandName',
          'whatsappBuyTemplate', 'whatsappConsultTemplate', 'whatsappClassTemplate',
          'classesSubtitle', 'presencialCities', 'onlineLabel',
          'updatedAt'
        ])
        && isNonEmptyString(d.whatsappNumber, 20)
        && isNonEmptyString(d.whatsappDisplay, 40)
        && isNonEmptyString(d.brandName, 80)
        && isNonEmptyString(d.whatsappBuyTemplate, 500)
        && isNonEmptyString(d.whatsappConsultTemplate, 500)
        && isNonEmptyString(d.whatsappClassTemplate, 500)
        && isNonEmptyString(d.classesSubtitle, 400)
        && validStringArray(d.presencialCities, 12, 60)
        && isNonEmptyString(d.onlineLabel, 120)
        && d.updatedAt is timestamp;
    }

    function categoryValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'label', 'sortOrder', 'published', 'createdAt', 'updatedAt'])
        && validSlug(d.id)
        && isNonEmptyString(d.label, 80)
        && d.sortOrder is number && d.sortOrder >= 0 && d.sortOrder <= 100000
        && d.published is bool
        && d.updatedAt is timestamp;
    }

    function classValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'emoji', 'image', 'description',
          'sortOrder', 'published', 'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(d.name, 80)
        && isOptionalString(d.emoji, 8)
        && validUrl(d.image)
        && isNonEmptyString(d.description, 1000)
        && d.sortOrder is number && d.sortOrder >= 0 && d.sortOrder <= 100000
        && d.published is bool
        && d.updatedAt is timestamp;
    }

    function testimonialValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'text', 'authorName', 'authorRole', 'authorInitials',
          'stars', 'sortOrder', 'published', 'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(d.text, 1000)
        && isNonEmptyString(d.authorName, 80)
        && isNonEmptyString(d.authorRole, 120)
        && isNonEmptyString(d.authorInitials, 4)
        && d.stars is number && d.stars >= 1 && d.stars <= 5
        && d.sortOrder is number && d.sortOrder >= 0 && d.sortOrder <= 100000
        && d.published is bool
        && d.updatedAt is timestamp;
    }

    // ── PRESETS ─────────────────────────────────────────────
    match /presets/{presetId} {
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if isAdmin()
        || (resource.data.published == true);

      allow create: if isAdmin()
        && presetDataValid()
        && request.resource.data.createdAt is timestamp;

      allow update: if isAdmin()
        && presetDataValid()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.slug == resource.data.slug;

      allow delete: if isAdmin();
    }

    // ── SETTINGS GLOBALES ───────────────────────────────────
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && siteSettingsValid();
    }

    // ── CATEGORÍAS ──────────────────────────────────────────
    match /categories/{catId} {
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && categoryValid()
        && request.resource.data.id == catId
        && request.resource.data.createdAt is timestamp;

      allow update: if isAdmin()
        && categoryValid()
        && request.resource.data.id == catId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin() && catId != 'all';
    }

    // ── CLASES ──────────────────────────────────────────────
    match /classes/{classId} {
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && classValid()
        && request.resource.data.createdAt is timestamp;

      allow update: if isAdmin()
        && classValid()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // ── TESTIMONIOS ─────────────────────────────────────────
    match /testimonials/{testimonialId} {
      allow get: if (resource.data.published == true) || isAdmin();
      allow list: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && testimonialValid()
        && request.resource.data.createdAt is timestamp;

      allow update: if isAdmin()
        && testimonialValid()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // ── AUDITORÍA ───────────────────────────────────────────
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'action', 'presetId', 'adminUid', 'adminEmail', 'timestamp'
        ])
        && request.resource.data.action is string
        && request.resource.data.action in [
          'preset_created', 'preset_updated',
          'preset_published', 'preset_unpublished', 'preset_deleted',
          'settings_updated',
          'category_created', 'category_updated', 'category_deleted',
          'class_created', 'class_updated', 'class_deleted',
          'testimonial_created', 'testimonial_updated', 'testimonial_deleted'
        ]
        && request.resource.data.presetId is string
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail is string
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
